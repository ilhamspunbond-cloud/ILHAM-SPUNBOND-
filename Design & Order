        <div class="relative w-full max-w-sm h-64 rounded-2xl overflow-hidden shadow-2xl border border-emerald-500/40 bg-slate-900 flex items-center justify-center">
            <!-- Tempat Video Logo / Animasi Pembukaan -->
            <video id="intro-video-el" autoplay muted playsinline class="w-full h-full object-cover">
                <source src="https://assets.mixkit.co/videos/preview/mixkit-digital-animation-of-screens-and-lights-31955-large.mp4" type="video/mp4">
                Your browser does not support the video tag.
            </video>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent flex items-end justify-center pb-4">
                <span class="text-xs text-amber-300 font-bold tracking-widest uppercase">ILHAM SPUNBOND OFFICIAL</span>
            </div>
        </div>
        <div class="space-y-2">
            <h2 class="text-xl font-extrabold text-white">Selamat Datang di ILHAM SPUNBOND</h2>
            <p class="text-xs text-slate-400 max-w-xs mx-auto">Pusat Custom Tas Spunbond & Sablon Profesional Terbaik & Terpercaya.</p>
        </div>
        <button type="button" onclick="dismissSplashScreen()" class="w-full max-w-xs bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg transition text-sm cursor-pointer flex items-center justify-center gap-2">
            <span>✨</span> Mulai Desain & Pesan Sekarang
        </button>
    </div>

    <div class="max-w-md mx-auto p-4 sm:p-6 space-y-4">
        <!-- Header Brand & Real-Time WIB Clock -->
        <div class="bg-emerald-800 text-white p-5 rounded-2xl shadow-lg text-center flex flex-col items-center justify-center relative">
            <div id="wib-clock-badge" class="absolute top-3 right-3 bg-emerald-900/80 border border-emerald-600/60 text-emerald-200 text-[10px] font-mono px-2 py-1 rounded-lg shadow-sm">
                🕒 <span id="live-wib-time">--:--:--</span> WIB
            </div>
            
            <div id="brand-logo-container" class="mb-2 bg-white/10 p-2.5 rounded-xl border border-emerald-600/50 flex items-center justify-center min-h-[60px] min-w-[140px]">
                <img id="header-brand-logo" src="https://via.placeholder.com/160x55?text=ILHAM+SPUNBOND" alt="Logo Brand" class="max-h-16 w-auto object-contain filter drop-shadow">
            </div>
            <h1 id="brand-title-text" class="text-xl font-bold tracking-wide">ILHAM SPUNBOND</h1>
            <p class="text-xs text-emerald-200 mt-1">Sistem Pemesanan Custom Tas Spunbond & Sablon</p>

            <!-- Tombol Audio Selamat Datang -->
            <button type="button" onclick="playWelcomeSpeech()" class="mt-3 bg-emerald-700 hover:bg-emerald-600 text-emerald-100 text-[11px] font-semibold py-1.5 px-3 rounded-full border border-emerald-500/50 shadow flex items-center gap-1.5 cursor-pointer transition">
                <span>🔊</span> Putar Suara Sambutan
            </button>
        </div>

        <!-- INFO ANTREAN & ESTIMASI PRODUKSI LIVE -->
        <div class="bg-amber-50 border border-amber-200 p-4 rounded-2xl shadow-sm space-y-2">
            <div class="flex items-center justify-between text-xs font-bold text-amber-900 border-b border-amber-200 pb-1.5">
                <span class="flex items-center gap-1.5"><span>⏳</span> Status Antrean & Estimasi Produksi Live</span>
                <span id="queue-count-badge" class="bg-amber-200 text-amber-900 px-2 py-0.5 rounded-full text-[10px]">Memuat...</span>
            </div>
            <p id="queue-est-text" class="text-[11px] text-amber-800 leading-relaxed">
                Menghitung antrean PO aktif di sistem cloud...
            </p>
        </div>

        <!-- AREA CUSTOMER -->
        <div id="customer-view" class="space-y-4">
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <label class="block text-xs font-semibold text-slate-600 mb-1">1. Pilih Model Tas Spunbond</label>
                <select id="bag-model-select" onchange="onCustomerModelChange()" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none">
                </select>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <label class="block text-xs font-semibold text-slate-600 mb-1">2. Pilih Ukuran Tas (Size)</label>
                <select id="bag-size-select" onchange="onCustomerSizeSelect()" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none">
                </select>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <label class="block text-xs font-semibold text-slate-600 mb-2">3. Pilih Warna Kain Tas (<span id="active-color-label" class="text-emerald-700 font-bold">Putih Bersih</span>)</label>
                <div id="bag-color-buttons" class="flex flex-wrap gap-2"></div>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 space-y-2">
                <label class="block text-xs font-semibold text-slate-600">4. Upload Logo / Desain Anda (Background Transparan Cepat)</label>
                <input type="file" id="customer-logo-upload" accept="image/*" onchange="loadCustomerLogo(event)" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
                <div id="logo-upload-status" class="text-[10px] text-slate-400 italic"></div>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <label class="block text-xs font-semibold text-slate-600 mb-1">5. Pilih Metode Cetak</label>
                <select id="print-method" onchange="togglePrintMethod()" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none">
                    <option value="manual">Sablon Manual (Warna Tinta Pilihan)</option>
                    <option value="dtf">DTF Full Color (Warna Asli Desain)</option>
                </select>
            </div>

            <div id="manual-ink-box" class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <label class="block text-xs font-semibold text-slate-600 mb-1">6. Pilih Warna Tinta Sablon Manual</label>
                <select id="ink-color-select" onchange="updateProcessedLogo()" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none">
                </select>
            </div>

            <div id="dtf-size-box" class="hidden bg-emerald-50 p-4 rounded-2xl shadow-sm border border-emerald-200 space-y-2">
                <label class="block text-xs font-semibold text-emerald-800">6. Pilih Ukuran Stiker DTF</label>
                <select id="dtf-size-select" onchange="calculateItemPrice(); updateCartTotals();" class="w-full bg-white border border-emerald-300 rounded-xl p-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none text-emerald-900">
                </select>
            </div>

            <!-- Kontrol Posisi Logo -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 space-y-3">
                <h3 class="text-xs font-bold text-slate-700">🎛️ Pengaturan Posisi & Ukuran Logo</h3>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div>
                        <label class="block text-slate-500 mb-1">Ukuran Logo (<span id="scale-val">100</span>%)</label>
                        <input type="range" id="logo-scale" min="40" max="200" value="100" oninput="adjustLogoTransform()" class="w-full accent-emerald-600">
                    </div>
                    <div>
                        <label class="block text-slate-500 mb-1">Rotasi (<span id="rotate-val">0</span>°)</label>
                        <input type="range" id="logo-rotate" min="-180" max="180" value="0" oninput="adjustLogoTransform()" class="w-full accent-emerald-600">
                    </div>
                    <div>
                        <label class="block text-slate-500 mb-1">Geser Kiri/Kanan</label>
                        <input type="range" id="logo-pos-x" min="-100" max="100" value="0" oninput="adjustLogoTransform()" class="w-full accent-emerald-600">
                    </div>
                    <div>
                        <label class="block text-slate-500 mb-1">Geser Atas/Bawah</label>
                        <input type="range" id="logo-pos-y" min="-80" max="80" value="0" oninput="adjustLogoTransform()" class="w-full accent-emerald-600">
                    </div>
                </div>
            </div>

            <!-- BOX 1: Preview Mockup Tas -->
            <div class="bg-white p-4 rounded-2xl shadow-md border border-slate-200 relative space-y-3">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <span>🛍️</span> Box 1: Preview Mockup Tas (Customer View)
                </h2>
                
                <div id="capture-mockup" class="relative w-full h-72 bg-white rounded-xl flex items-center justify-center overflow-hidden shadow-inner border border-slate-200">
                    <div class="absolute inset-0 bg-white"></div>
                    <canvas id="bag-preview-canvas" class="absolute inset-0 w-full h-full object-contain p-2 pointer-events-none"></canvas>

                    <div class="absolute bottom-2 left-3 pointer-events-none z-10 flex gap-1.5">
                        <span id="preview-model-label" class="text-slate-700 text-[11px] font-bold bg-white/90 px-2 py-0.5 rounded shadow-sm border border-slate-200">[ Tas Oval ]</span>
                        <span id="preview-size-label" class="text-emerald-700 text-[11px] font-bold bg-white/90 px-2 py-0.5 rounded shadow-sm border border-slate-200">[ 20 x 30 cm ]</span>
                    </div>
                    
                    <div id="logo-layer" class="absolute cursor-move flex items-center justify-center p-2 z-10" style="transform: translate(0px, 0px) scale(1) rotate(0deg);">
                        <img id="preview-logo-img" src="" alt="Logo" class="max-h-24 object-contain filter drop-shadow-md">
                    </div>

                    <div class="web-watermark">
                        <span class="watermark-text-display watermark-single">ILHAM SPUNBOND</span>
                    </div>
                </div>

                <!-- Input Quantity Full Lebar (Aman Partai Besar) -->
                <div class="space-y-2 pt-1">
                    <label class="block text-xs font-bold text-slate-700">Quantity / Jumlah Pesanan Item Ini (Pcs)</label>
                    <input type="number" id="item-qty" value="500" min="1" oninput="updateCartTotals()" class="w-full bg-slate-50 border-2 border-emerald-500 rounded-xl p-3 text-lg font-extrabold text-emerald-800 text-center focus:ring-2 focus:ring-emerald-500 outline-none shadow-inner">
                </div>

                <button type="button" onclick="addItemToCart()" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 px-4 rounded-xl text-xs shadow-md transition cursor-pointer flex items-center justify-center gap-2">
                    <span>➕</span> Masukkan ke Keranjang Pesanan (Mix)
                </button>
            </div>

            <!-- Keranjang Mix Item Pesanan -->
            <div class="bg-white p-4 rounded-2xl shadow-md border border-slate-200 space-y-3">
                <h3 class="text-xs font-bold text-slate-800 border-b border-slate-100 pb-2 flex items-center justify-between">
                    <span>🛒 Daftar Mix Item Pesanan (<span id="cart-count">0</span> Item)</span>
                    <button type="button" onclick="clearCart()" class="text-rose-600 hover:underline text-[10px] cursor-pointer">Kosongkan</button>
                </h3>
                <div id="cart-items-container" class="space-y-2 max-h-56 overflow-y-auto pr-1">
                    <p class="text-xs text-slate-400 text-center py-4">Belum ada item ditambahkan ke keranjang pesanan.</p>
                </div>
            </div>

            <!-- BOX 2: Production View -->
            <div class="bg-slate-900 text-white p-4 rounded-2xl shadow-md border border-slate-800 relative space-y-2">
                <h2 class="text-sm font-semibold text-amber-400 flex items-center gap-2">
                    <span>📐</span> Box 2: Detail Desain & Film Produksi (Preview)
                </h2>
                <div id="customer-watermark-box" class="relative bg-white p-4 rounded-xl flex flex-col items-center justify-center min-h-[220px] text-slate-900 space-y-3 overflow-hidden shadow-inner">
                    <div class="w-full h-56 flex items-center justify-center bg-white rounded-lg border border-slate-200 overflow-hidden p-2">
                        <img id="owner-file-img" src="" alt="Belum ada desain diupload" class="max-h-full max-w-full object-contain">
                        <p id="owner-placeholder-text" class="absolute text-xs text-slate-400 font-medium">⬆️ Silakan upload logo/desain di atas terlebih dahulu</p>
                    </div>
                    <div class="text-center text-xs font-bold text-slate-800 border-t border-slate-200 pt-2 w-full flex justify-between px-2 z-10">
                        <span>Model: <b id="owner-model-txt">-</b></span>
                        <span>Metode: <b id="owner-method-txt">-</b></span>
                    </div>

                    <div class="web-watermark">
                        <span class="watermark-text-display watermark-single">ILHAM SPUNBOND</span>
                    </div>
                </div>
                <p class="text-[11px] text-slate-400 text-center italic">🔒 Area Box 2 dikunci khusus untuk pratinjau produksi. Download file bersih hanya tersedia di Galeri Owner.</p>
            </div>

            <!-- FORMULIR PEMESANAN & REKENING BANK -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-md border border-slate-200 space-y-4">
                <h3 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-2 flex items-center gap-2">
                    <span>📋</span> Formulir Pesanan & Pembayaran
                </h3>
                
                <div>
                    <label class="block text-[11px] font-semibold text-slate-500 mb-1">Nama Pemesan</label>
                    <input type="text" id="customer-name" placeholder="Cth: Budi Santoso" oninput="saveCustomerDataMemory()" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>

                <div>
                    <label class="block text-[11px] font-semibold text-slate-500 mb-1">Nomor WhatsApp Pemesan</label>
                    <input type="text" id="customer-wa" placeholder="Cth: 08123456789" oninput="saveCustomerDataMemory()" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>

                <div>
                    <label class="block text-[11px] font-semibold text-slate-500 mb-1">Alamat Pengiriman Lengkap</label>
                    <textarea id="customer-address" rows="2" placeholder="Cth: Jl. Melati No. 10, Bandung" oninput="saveCustomerDataMemory()" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none"></textarea>
                </div>

                <div>
                    <label class="block text-[11px] font-semibold text-slate-500 mb-1">Wilayah Tujuan Pengiriman</label>
                    <select id="shipping-region" onchange="saveCustomerDataMemory(); updateCartTotals();" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none">
                        <option value="jabodetabek">Wilayah Jabodetabek (Bisa COD)</option>
                        <option value="luar">Di Luar Jabodetabek (Wajib DP 50% / Pelunasan)</option>
                    </select>
                </div>

                <div class="text-[11px] text-emerald-700 font-medium bg-emerald-50/80 px-3 py-1.5 rounded-lg border border-emerald-200/60 flex items-center gap-1.5">
                    <span>🔥</span> <span>Info Diskon: Total pesanan **1.000 pcs ke atas** otomatis mendapatkan **Diskon 10%**!</span>
                </div>

                <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-xl space-y-3">
                    <div class="flex justify-between items-center text-xs text-slate-700 border-b border-emerald-200/60 pb-2">
                        <span>Total Quantity Pesanan:</span>
                        <span id="display-total-qty" class="font-bold text-slate-900 text-sm">0 Pcs</span>
                    </div>
                    <div id="discount-row" class="hidden flex justify-between items-center text-xs text-emerald-700 font-medium border-b border-emerald-200/60 pb-2">
                        <span>Diskon Pesanan Besar (10%):</span>
                        <span id="display-discount-val" class="font-bold">- Rp 0</span>
                    </div>
                    <div id="dp-row" class="hidden flex justify-between items-center text-xs text-amber-700 font-medium border-b border-emerald-200/60 pb-2">
                        <span>Wajib DP 50% (Luar Jabodetabek):</span>
                        <span id="display-dp-val" class="font-bold">Rp 0</span>
                    </div>
                    
                    <div class="pt-1 flex justify-between items-center">
                        <div>
                            <span class="text-xs font-bold text-emerald-900 block">Total Keseluruhan:</span>
                            <span class="text-[10px] text-emerald-700 block italic">✨ Termasuk ongkir Pulau Jawa</span>
                        </div>
                        <div class="text-right">
                            <span id="display-total-price" class="text-lg font-extrabold text-emerald-950 block">Rp 0</span>
                        </div>
                    </div>
                </div>

                <!-- Info Nomor Rekening Bank -->
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-2">
                    <h4 class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                        <span>💳</span> Informasi Rekening Pembayaran Resmi
                    </h4>
                    <div id="bank-accounts-display" class="space-y-1.5 text-xs text-slate-600"></div>
                </div>
            </div>

            <!-- TOMBOL KIRIM KE WHATSAPP OWNER -->
            <button type="button" onclick="saveOrderAndSendWhatsApp()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3.5 px-4 rounded-xl shadow-lg flex items-center justify-center gap-2.5 transition text-sm cursor-pointer">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                <span>Simpan PO & Kirim Pesan ke WhatsApp Owner</span>
            </button>

            <!-- TOMBOL DOWNLOAD INVOICE PDF -->
            <button type="button" onclick="downloadCustomerInvoicePDF()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-4 rounded-xl shadow-lg flex items-center justify-center gap-2 transition text-sm cursor-pointer">
                <span>📄🖨️</span> Download Invoice Tagihan (PDF)
            </button>

            <!-- TOMBOL BUKA GALERI RIWAYAT PO OWNER -->
            <button type="button" onclick="verifyAndShowOrderHistory()" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-3 px-4 rounded-xl shadow-lg flex items-center justify-center gap-2 transition text-sm cursor-pointer">
                <span>🔐📋</span> Buka Galeri Visual Riwayat PO (Terkunci Password)
            </button>
        </div>

        <!-- MODAL RIWAYAT PO -->
