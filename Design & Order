        function initQueueListener() {
            if(!window.firebaseDb) return;
            const { collection, onSnapshot } = window.firebaseDeps;
            onSnapshot(collection(window.firebaseDb, "orders"), (snapshot) => {
                let pendingOrders = [];
                snapshot.forEach(doc => {
                    const data = doc.data();
                    if(!data.status || !data.status.includes("LUNAS")) {
                        pendingOrders.push(data);
                    }
                });
                updateQueueDisplay(pendingOrders);
            }, (err) => {
                console.log("Queue listener error:", err);
            });
        }

        function calculateProductionDays(totalQty) {
            if (totalQty <= 500) return 3;
            if (totalQty <= 1000) return 3;
            const extraSteps = Math.ceil((totalQty - 1000) / 500);
            return 3 + extraSteps;
        }

        function updateQueueDisplay(pendingOrders) {
            const badge = document.getElementById('queue-count-badge');
            const desc = document.getElementById('queue-est-text');
            if(!badge || !desc) return;

            let totalQueueQty = 0;
            pendingOrders.forEach(o => {
                if(o.items) {
                    o.items.forEach(it => { totalQueueQty += (it.qty || 0); });
                }
            });

            const queueCount = pendingOrders.length;
            badge.textContent = `${queueCount} PO Antre (${totalQueueQty.toLocaleString('id-ID')} Pcs)`;

            let accumulatedDays = 0;
            pendingOrders.forEach(o => {
                let oQty = 0;
                if(o.items) o.items.forEach(it => oQty += (it.qty || 0));
                accumulatedDays += calculateProductionDays(oQty);
            });

            let currentCartQty = 0;
            cartItems.forEach(it => currentCartQty += (it.qty || 0));
            const myProductionDays = calculateProductionDays(currentCartQty > 0 ? currentCartQty : 500);
            const totalEstimatedDays = accumulatedDays + myProductionDays;

            const targetDate = new Date();
            targetDate.setDate(targetDate.getDate() + totalEstimatedDays);
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const formattedDate = targetDate.toLocaleDateString('id-ID', options);

            if(queueCount === 0) {
                desc.innerHTML = `✨ <b>Tidak ada antrean PO menumpuk saat ini!</b> Pesanan Anda akan langsung masuk jalur prioritas dengan estimasi pengerjaan <b>${myProductionDays} hari</b> (Selesai sekitar <b>${formattedDate}</b>).`;
            } else {
                desc.innerHTML = `⚠️ Saat ini ada <b>${queueCount} PO antre</b> di sistem produksi (Total ${totalQueueQty.toLocaleString('id-ID')} pcs). Estimasi pengerjaan pesanan Anda sekitar <b>${totalEstimatedDays} hari</b> kerja (Perkiraan selesai: <b>${formattedDate}</b>).`;
            }
        }

        function compressImageToDataUrl(file, maxWidth = 250, quality = 0.5) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        let w = img.width, h = img.height;
                        if(w > maxWidth) {
                            h = Math.round((h * maxWidth) / w);
                            w = maxWidth;
                        }
                        canvas.width = w;
                        canvas.height = h;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, w, h);
                        resolve(canvas.toDataURL('image/jpeg', quality));
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        function cleanOuterBackground(file, maxWidth = 350, quality = 0.6) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        let w = img.width, h = img.height;
                        if(w > maxWidth) {
                            h = Math.round((h * maxWidth) / w);
                            w = maxWidth;
                        }
                        canvas.width = w;
                        canvas.height = h;
                        const ctx = canvas.getContext('2d');
                        ctx.clearRect(0, 0, w, h);
                        ctx.drawImage(img, 0, 0, w, h);
                        resolve(canvas.toDataURL('image/jpeg', quality));
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

